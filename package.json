{
  "name": "yance-personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "tsx scripts/smoke-test.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "lighthouse": "lhci autorun --config=.lighthouserc.json && lhci autorun --config=.lighthouserc.mobile.json",
    "lighthouse:interactions": "node scripts/lighthouse-interactions.mjs",
    "links": "tsx scripts/check-external-links.ts",
    "images:concerts": "python scripts/generate-concert-thumbnails.py",
    "audit:assets": "python scripts/audit-assets.py",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "deadcode": "knip --include files,dependencies,unlisted,unresolved,exports,types --no-progress",
    "check": "npm run lint && npm run typecheck && npm run deadcode && npm run unit && npm run sitemap && npm run build && npm run smoke",
    "lint": "eslint . --max-warnings=0",
    "unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.60.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "lighthouse": "13.4.1",
    "playwright-core": "1.60.0",
    "puppeteer-core": "24.43.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "optionalDependencies": {
    "proxy-agent": "8.0.2"
  }
}
