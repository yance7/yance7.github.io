{
  "name": "yance-personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "npm run sitemap && vite build --config config/vite.config.ts && tsx scripts/normalize-page-output.ts && tsx scripts/generate-localized-pages.ts && tsx scripts/generate-legacy-pages.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "brand:assets": "python scripts/generate-brand-assets.py",
    "brand:assets:check": "python scripts/generate-brand-assets.py --check",
    "lighthouse": "lhci autorun --config=config/lighthouse.desktop.json && lhci autorun --config=config/lighthouse.mobile.json",
    "lighthouse:interactions": "node scripts/lighthouse-interactions.mjs",
    "links": "tsx scripts/check-external-links.ts",
    "images:concerts": "python scripts/generate-concert-thumbnails.py",
    "audit:assets": "python scripts/audit-assets.py",
    "audit:repo": "tsx scripts/check-repository-hygiene.ts",
    "typecheck": "vue-tsc --noEmit -p config/tsconfig.app.json && tsc --noEmit -p config/tsconfig.node.json && tsc --noEmit -p config/tsconfig.test.json",
    "deadcode": "knip --config config/knip.json --include files,dependencies,unlisted,unresolved,exports,types --no-progress",
    "check": "npm run audit:repo && npm run audit:assets && npm run brand:assets:check && npm run lint && npm run typecheck && npm run deadcode && npm run unit && npm run sitemap && npm run build && npm run smoke",
    "lint": "eslint --config config/eslint.config.js . --max-warnings=0",
    "unit": "vitest run --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-hk": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.60.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "knip": "^6.32.2",
    "lighthouse": "13.4.1",
    "playwright-core": "1.60.0",
    "puppeteer-core": "24.43.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "optionalDependencies": {
    "proxy-agent": "8.0.2"
  }
}
